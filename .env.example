# GitHub Personal Access Token (with repo / contents write permission)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Target GitHub Repository: username/repo-name
GITHUB_REPO=your_username/your_repo

# Source API URL
MEDIA_API_URL=https://ak.xworms.xyz/api.php?action=list&sync=1

# GitHub Release tag to store video assets
RELEASE_TAG=media-vault

# Optional: HTTP/SOCKS Proxy if your local network is 403-blocked by Cloudflare
# PROXY_URL=http://127.0.0.1:7890
